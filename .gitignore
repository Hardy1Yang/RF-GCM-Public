# Datasets (not distributed with the repo; see README for download instructions)
dataset/*
!dataset/.gitkeep

# R intermediate files
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Results (generated by running the pipeline)
results/*
!results/.gitkeep
result_tab_fig/*
!result_tab_fig/.gitkeep

# Log files from parallel execution
logs/*
!logs/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Temporary files
*~
*.swp
